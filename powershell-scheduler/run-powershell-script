#!/bin/bash
set -u

JOB_NAME="${1:-}"
SCRIPT="${2:-}"
LOGFILE="${3:-}"

# ------------------------------------------------------------
# Validate arguments
# ------------------------------------------------------------

if [ -z "$JOB_NAME" ] || [ -z "$SCRIPT" ] || [ -z "$LOGFILE" ]; then
    echo "Usage: $0 <job-name> <script.ps1> <logfile>" >&2
    exit 2
fi

# ------------------------------------------------------------
# Validate script
# ------------------------------------------------------------

if [ ! -f "$SCRIPT" ]; then
    echo "$(date '+%Y-%m-%d %H:%M:%S.%4N') ERROR: Script not found: $SCRIPT" >&2
    exit 2
fi

# ------------------------------------------------------------
# Prepare log directory
# ------------------------------------------------------------

LOGDIR="$(dirname "$LOGFILE")"

if ! mkdir -p "$LOGDIR"; then
    echo "$(date '+%Y-%m-%d %H:%M:%S.%4N') ERROR: Unable to create log directory: $LOGDIR" >&2
    exit 2
fi

# ------------------------------------------------------------
# Create a unique lock based on the job name
#
# Hashing the name keeps the lock filename safe regardless
# of characters used in the job name.
# ------------------------------------------------------------

LOCK_NAME="$(printf '%s' "$JOB_NAME" | sha256sum | cut -d' ' -f1)"
LOCKFILE="/tmp/powershell-${LOCK_NAME}.lock"

exec 9>"$LOCKFILE"

if ! flock -n 9; then
    echo "$(date '+%Y-%m-%d %H:%M:%S.%4N') SKIPPED: Job '$JOB_NAME' is already running script '$SCRIPT'" >> "$LOGFILE"
    exit 0
fi

# ------------------------------------------------------------
# Run PowerShell script
# ------------------------------------------------------------

START_TIME="$(date '+%Y-%m-%d %H:%M:%S.%4N')"

{
    echo "============================================================"
    echo "START:    $START_TIME"
    echo "JOB:      $JOB_NAME"
    echo "SCRIPT:   $SCRIPT"
    echo "============================================================"

    pwsh \
        -NoLogo \
        -NoProfile \
        -NonInteractive \
        -File "$SCRIPT"

    EXIT_CODE=$?

    END_TIME="$(date '+%Y-%m-%d %H:%M:%S.%4N')"

    echo
    echo "============================================================"
    echo "END:      $END_TIME"
    echo "JOB:      $JOB_NAME"
    echo "EXIT CODE: $EXIT_CODE"
    echo "============================================================"
    echo

} >> "$LOGFILE" 2>&1

# ------------------------------------------------------------
# Return the PowerShell exit code to cron
# ------------------------------------------------------------

exit "$EXIT_CODE"
